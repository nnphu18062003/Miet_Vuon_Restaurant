<header class="bg-[#A7C1A8] py-2 relative z-50" style="overflow: visible;">
  <div class="container mx-auto flex items-center justify-between px-3 sm:px-6 h-full gap-2 flex-wrap md:flex-nowrap">
    <!-- Logo và Tên Thương Hiệu -->
    <div class="flex items-center">
      <a href="/" class="flex items-center">
        <img src="/images/logo1.png" alt="Logo" 
             class="h-14 w-14 sm:h-16 sm:w-16 md:h-20 md:w-20 rounded-full mr-2 sm:mr-3 border-2 border-white object-contain" />
        <div class="flex flex-col">
          <span class="text-[#2D4F2B] font-bold uppercase text-lg sm:text-xl md:text-2xl leading-tight">Miet Vuon</span>
          <span class="text-[#2D4F2B] font-bold uppercase text-sm sm:text-base md:text-xl leading-tight">Restaurant</span>
        </div>
      </a>
    </div>

    <!-- Menu Điều Hướng -->
    <nav class="order-3 w-full md:order-2 md:w-auto flex justify-center md:justify-center items-center gap-4 md:gap-8 mt-2 md:mt-0 text-sm sm:text-base md:text-lg">
      <a href="/" class="text-white hover:underline leading-none uppercase font-bold whitespace-nowrap">Trang chủ</a>
      <a href="/category" class="text-white hover:underline leading-none uppercase font-bold whitespace-nowrap">Thực đơn</a>
      <a href="/about" class="text-white hover:underline leading-none uppercase font-bold whitespace-nowrap">Về nhà hàng</a>
    </nav>

    <!-- Biểu Tượng -->
    <div class="flex items-center space-x-3 sm:space-x-4 order-2 md:order-3">
      
      <!-- User Profile Dropdown -->
      <div class="relative group" style="z-index: 1000;">
        <a href="#" class="text-white hover:text-gray-300 relative z-10">
          <i class="fas fa-user text-3xl"></i>
        </a>
        <!-- Dropdown Menu -->
        <div
          class="absolute right-0 top-full mt-2 w-48 bg-[#EBF4DD] border border-gray-300 rounded-md shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
          style="z-index: 1001;">
          <a href="/account" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-t-md">Tài khoản</a>
          <a href="/orderList" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">Đơn mua</a>
          <a href="/login" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-b-md">Đăng nhập</a>
        </div>
      </div>

      <!-- Shopping Bag Icon -->
      <a href="/cart" class="text-white hover:text-gray-300">
        <i class="fas fa-shopping-bag text-3xl"></i>
      </a>
    </div>
  </div>
</header>
