<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= title %>
    </title>
    <link id="favicon" rel="icon" type="image/png" href="/images/favicon.png">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="referrer" content="always" />
    <meta name="description" content="TailwindCSS Ecommerce Template" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@2.8.2/dist/alpine.min.js" defer></script>
</head>

<body class="bg-gray-100">
    <div>
        <%- include('header') %>
            <!-- #endregion Header -->

            <!-- <main class="">
            <%- content %>
        </main> -->
    </div>



    <script src="/js/header.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Server-side user injection
            const user = <% - JSON.stringify(locals.user || null) %>;

            // Header Logic
            if (user) {
                const loginLink = document.querySelector('a[href="/login"]');
                const registerLink = document.querySelector('a[href="/register"]');

                if (loginLink) {
                    loginLink.innerHTML = '<i class="fas fa-sign-out-alt mr-2"></i>Đăng xuất';
                    loginLink.href = '/logout';
                }

                if (registerLink) {
                    registerLink.style.display = 'none';
                }
            }

            // GLOBAL FLASH MESSAGES HANDLER
            const successMessages = <% - JSON.stringify(locals.success || []) %>;
            const errorMessages = <% - JSON.stringify(locals.error || []) %>;
            const legacyMessage = <% - JSON.stringify(locals.message || "") %>;

            if (successMessages && successMessages.length > 0) {
                const msg = Array.isArray(successMessages) ? successMessages[0] : successMessages;
                if (msg) showSnackbar(msg, 'success');
            }

            if (errorMessages && errorMessages.length > 0) {
                const msg = Array.isArray(errorMessages) ? errorMessages[0] : errorMessages;
                if (msg) showSnackbar(msg, 'error');
            }

            if (legacyMessage && typeof legacyMessage === 'string' && legacyMessage.length > 0) {
                const type = legacyMessage.toLowerCase().includes('thành công') || legacyMessage.toLowerCase().includes('success') ? 'success' : 'error';
                showSnackbar(legacyMessage, type);
            }
        });
    </script>


</body>

</html>