<div class="col-span-1 bg-white px-4 pb-6 shadow overflow-hidden rounded-lg mt-5">
  <div class="divide-y divide-gray-200 space-y-5">
    <!--region typeOfFood-->
    <div class="pt-4">
      <h2 class="text-xl text-gray-800 mb-4 uppercase font-bold">Bộ lọc tìm kiếm</h2>
      <h3 class="text-lg text-gray-700 mb-4 font-semibold">Danh mục món ăn</h3>
      <form id="typeOfFood-filter-form">
        <div class="space-y-3">
          <% if (typeOfFoods && typeOfFoods.length > 0) { %>
            <% typeOfFoods.forEach((typeOfFood, index) => { %>
              <div class="flex items-center hover:bg-gray-50 p-2 rounded-md transition-colors">
                <input 
                  type="checkbox" 
                  name="typeOfFoods" 
                  value="<%= typeOfFood %>" 
                  id="typeOfFood-<%= index %>" 
                  class="w-4 h-4 text-[#66BB6A] border-gray-300 rounded focus:ring-[#66BB6A] focus:ring-2 cursor-pointer"
                  <% if (selectedtypeOfFoods && selectedtypeOfFoods.includes(typeOfFood)) { %>
                    checked
                  <% } %> 
                />
                <label for="typeOfFood-<%= index %>" class="text-gray-700 ml-3 cursor-pointer text-base font-medium hover:text-[#66BB6A] transition-colors">
                  <%= typeOfFood %>
                </label>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-gray-500 text-sm">Không có danh mục nào.</p>
          <% } %>
        </div>
      </form>
    </div>
    
    <!--region filter min max value-->
    <form id="price-filter-form" method="GET">
      <div class="pt-4">
        <h3 class="text-lg text-gray-700 mb-4 font-semibold">Khoảng giá</h3>
        <div class="mt-4 flex items-center gap-2">
          <input 
            type="number" 
            name="min" 
            id="min" 
            class="rounded-md w-full border-2 border-gray-300 focus:border-[#66BB6A] focus:ring-2 focus:ring-[#66BB6A] px-3 py-2 text-gray-700 shadow-sm transition-all" 
            placeholder="Từ (VNĐ)" 
            value="" 
            min="0"
          />
          <span class="text-gray-500 font-medium">-</span>
          <input 
            type="number" 
            name="max" 
            id="max" 
            class="rounded-md w-full border-2 border-gray-300 focus:border-[#66BB6A] focus:ring-2 focus:ring-[#66BB6A] px-3 py-2 text-gray-700 shadow-sm transition-all" 
            placeholder="Đến (VNĐ)" 
            value="" 
            min="0"
          />
        </div>
      </div>
    </form>

    <div class="flex justify-center items-center pt-4">
      <button 
        type="button" 
        onclick="applyAndUpdateFilters()" 
        class="mt-4 bg-[#66BB6A] hover:bg-[#4CAF50] text-white px-6 py-2.5 rounded-lg font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:scale-105"
      >
        Áp dụng bộ lọc
      </button>
    </div>
  </div>
</div>