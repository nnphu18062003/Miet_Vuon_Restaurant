<!DOCTYPE html>
<html lang="en">

<head>
    <link id="favicon" rel="icon" type="image/png" href="/images/favicon.png">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link href="//fonts.googleapis.com/css?family=Righteous" rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Open+Sans+Condensed:300,300i,700" rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i" rel="stylesheet" />

    <!-- Use main.css for Tailwind -->
    <link rel="stylesheet" href="/css/main.css" />
    <!-- Add Snackbar CSS -->
    <link rel="stylesheet" href="/css/snackbar.css">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <!-- #region Header -->
    <%- include('layouts/mainLayout', {content: locals.body}) %>
        <!-- #endregion Header -->
        <main class="my-8">
            <div class="text-center text-uppercase mb-6">
                <h2 class="text-3xl font-semibold">Đăng nhập</h2>
            </div>

            <div class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-lg">
                <form action="/login" method="POST">
                    <div class="mb-4"></div>
                    <div class="mb-4">
                        <label for="email" class="block text-gray-700">Email</label>
                        <input type="email" id="email" name="email"
                            class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#F7DCB9]"
                            required />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="block text-gray-700">Mật khẩu</label>
                        <input type="password" id="password" name="password"
                            class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#F7DCB9]"
                            required />
                    </div>

                    <!-- Fallback for simple message -->
                    <% if (typeof message==='string' && message.length> 0) { %>
                        <div class="alert alert-danger text-center text-red-500 mb-4">
                            <%= message %>
                        </div>
                        <% } else if (Array.isArray(locals.error) && locals.error.length> 0) { %>
                            <div class="alert alert-danger text-center text-red-500 mb-4">
                                <%= locals.error[0] %>
                            </div>
                            <% } %>

                                <div class="mb-4 flex items-center">
                                    <input type="checkbox" id="agree" name="agree" class="mr-2" required />
                                    <label for="agree" class="text-sm text-gray-600">Tôi đồng ý với những
                                        <a href="#" class="text-blue-500">Điều khoản và Điều kiện</a></label>
                                </div>

                                <div class="form-group mb-4">
                                    <button type="submit"
                                        class="w-full bg-[#914F1E] text-white py-2 rounded-md hover:bg-[#DEAC80]">
                                        Đăng nhập
                                    </button>
                                </div>

                                <div class="text-center mb-4">
                                    <span class="text-gray-500">Hoặc</span>
                                </div>

                                <div class="form-group mb-4">
                                    <a href="/auth/google"
                                        class="w-full flex items-center justify-center bg-white border border-gray-300 text-gray-700 py-2 rounded-md hover:bg-gray-50 transition-colors">
                                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google"
                                            class="w-5 h-5 mr-2">
                                        Đăng nhập bằng Google
                                    </a>
                                </div>

                                <div class="pt-2 text-center">
                                    <p class="text-sm text-gray-600">Bạn chưa đăng ký tài khoản?
                                        <a href="register" class="text-blue-500">Đăng ký</a>
                                    </p>
                                </div>
                </form>

            </div>
        </main>

        <!-- Snackbar Container -->
        <div id="snackbar"></div>

        <!-- #region Footer-->
        <%- include('layouts/footer') %>
            </footer>
            <!-- #endregion Footer -->

            <!-- Snackbar Script -->
            <script src="/js/snackbar.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    // Safe variable injection using JSON.stringify
                    const successMessages = <% - JSON.stringify(locals.success || []) %>;
                    const errorMessages = <% - JSON.stringify(locals.error || []) %>;
                    const legacyMessage = <% - JSON.stringify(locals.message || "") %>;

                    if (successMessages && successMessages.length > 0) {
                        const msg = Array.isArray(successMessages) ? successMessages[0] : successMessages;
                        if (msg) showSnackbar(msg, 'success');
                    }

                    if (errorMessages && errorMessages.length > 0) {
                        const msg = Array.isArray(errorMessages) ? errorMessages[0] : errorMessages;
                        if (msg) showSnackbar(msg, 'error');
                    }

                    if (legacyMessage && typeof legacyMessage === 'string' && legacyMessage.length > 0) {
                        const type = legacyMessage.toLowerCase().includes('thành công') || legacyMessage.toLowerCase().includes('success') ? 'success' : 'error';
                        showSnackbar(legacyMessage, type);
                    }
                });
            </script>
</body>

</html>