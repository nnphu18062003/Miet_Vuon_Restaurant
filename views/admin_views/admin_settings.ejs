<!DOCTYPE html>
<html lang="vi">

<head>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cài đặt - Miệt Vườn Restaurant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
        crossorigin="anonymous" />
    <link href="/css/admin-modern.css" rel="stylesheet">
    <link href="/css/snackbar.css" rel="stylesheet">
    <script src="/js/snackbar.js"></script>
</head>

<body>
    <%- include('admin_layouts/admin_sidebar_modern', { currentPage: 'settings' , pendingOrders: 0 }) %>
        <%- include('admin_layouts/admin_header_modern', { breadcrumb: ['Cài đặt'], user: locals.user || {},
            hasNotifications: false }) %>

            <main class="modern-content">
                <div style="margin-bottom: 2rem;">
                    <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--gray-900); margin-bottom: 0.5rem;">
                        Cài đặt Hệ thống
                    </h1>
                    <p style="color: var(--gray-600);">Quản lý cấu hình và thiết lập hệ thống</p>
                </div>

                <!-- Coming Soon -->
                <div class="modern-card">
                    <div class="card-body" style="text-align: center; padding: 4rem 2rem;">
                        <i class="fas fa-cog fa-spin"
                            style="font-size: 4rem; color: var(--primary-green); margin-bottom: 1.5rem;"></i>
                        <h2
                            style="font-size: 1.5rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.75rem;">
                            Tính năng đang phát triển
                        </h2>
                        <p style="color: var(--gray-600); margin-bottom: 2rem;">
                            Trang cài đặt với các tùy chọn cấu hình sẽ sớm được ra mắt
                        </p>
                        <div
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; max-width: 800px; margin: 0 auto;">
                            <div
                                style="padding: 1.5rem; background: var(--gray-50); border-radius: 12px; text-align: left;">
                                <i class="fas fa-store"
                                    style="font-size: 2rem; color: var(--info); margin-bottom: 1rem;"></i>
                                <h3 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem;">Thông tin
                                    nhà hàng</h3>
                                <p style="font-size: 0.875rem; color: var(--gray-600);">Tên, địa chỉ, liên hệ</p>
                            </div>
                            <div
                                style="padding: 1.5rem; background: var(--gray-50); border-radius: 12px; text-align: left;">
                                <i class="fas fa-clock"
                                    style="font-size: 2rem; color: var(--warning); margin-bottom: 1rem;"></i>
                                <h3 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem;">Giờ hoạt
                                    động</h3>
                                <p style="font-size: 0.875rem; color: var(--gray-600);">Cấu hình giờ mở cửa</p>
                            </div>
                            <div
                                style="padding: 1.5rem; background: var(--gray-50); border-radius: 12px; text-align: left;">
                                <i class="fas fa-truck"
                                    style="font-size: 2rem; color: var(--success); margin-bottom: 1rem;"></i>
                                <h3 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem;">Giao hàng
                                </h3>
                                <p style="font-size: 0.875rem; color: var(--gray-600);">Phí ship, khu vực</p>
                            </div>
                            <div
                                style="padding: 1.5rem; background: var(--gray-50); border-radius: 12px; text-align: left;">
                                <i class="fas fa-credit-card"
                                    style="font-size: 2rem; color: var(--error); margin-bottom: 1rem;"></i>
                                <h3 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.5rem;">Thanh toán
                                </h3>
                                <p style="font-size: 0.875rem; color: var(--gray-600);">Phương thức thanh toán</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
</body>

</html>