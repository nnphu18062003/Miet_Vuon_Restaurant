<!DOCTYPE html>
<html lang="vi">

<head>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.pageTitle || 'Admin' %> - Miệt Vườn Restaurant
    </title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
        crossorigin="anonymous" />

    <!-- Styles -->
    <link href="/css/admin-modern.css" rel="stylesheet">
    <link href="/css/snackbar.css" rel="stylesheet">

    <!-- Scripts -->
    <script src="/js/snackbar.js"></script>
</head>

<body>
    <!-- Modern Sidebar -->
    <%- include('admin_sidebar_modern', { currentPage: locals.currentPage || '' , pendingOrders: locals.pendingOrders ||
        0 }) %>

        <!-- Modern Header -->
        <%- include('admin_header_modern', { breadcrumb: locals.breadcrumb || [], user: locals.user || {},
            hasNotifications: locals.hasNotifications || false }) %>

            <!-- Main Content -->
            <main class="modern-content">
                <%- body %>
            </main>

            <!-- Flash Messages -->
            <script>
                document.addEventListener('DOMContentLoaded', function () {
            <% if (locals.success && success.length > 0) { %>
                        Snackbar.success('<%= success[0] %>');
            <% } %>
            <% if (locals.error && error.length > 0) { %>
                        Snackbar.error('<%= error[0] %>');
            <% } %>
        });
            </script>
</body>

</html>