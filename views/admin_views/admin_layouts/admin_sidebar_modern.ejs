<!-- Modern Sidebar -->
<aside class="modern-sidebar" id="modernSidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <img src="/images/logo1.png" alt="Logo" class="sidebar-logo">
        <span class="sidebar-brand">Miệt Vườn</span>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="sidebar-nav">
        <!-- Main Section -->
        <div class="nav-section">
            <div class="nav-section-title">Main</div>

            <div class="nav-item">
                <a href="/admin/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-home"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>
            </div>
        </div>

        <!-- Management Section -->
        <div class="nav-section">
            <div class="nav-section-title">Management</div>

            <div class="nav-item">
                <a href="/admin/products?page=1" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-utensils"></i></span>
                    <span class="nav-text">Sản phẩm</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/admin/orders" class="nav-link <%= currentPage === 'orders' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-shopping-cart"></i></span>
                    <span class="nav-text">Đơn hàng</span>
                    <% if (locals.pendingOrders && pendingOrders> 0) { %>
                        <span class="nav-badge">
                            <%= pendingOrders %>
                        </span>
                        <% } %>
                </a>
            </div>

            <div class="nav-item">
                <a href="/admin/customer" class="nav-link <%= currentPage === 'customers' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-users"></i></span>
                    <span class="nav-text">Khách hàng</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/admin/reviews" class="nav-link <%= currentPage === 'reviews' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-star"></i></span>
                    <span class="nav-text">Đánh giá</span>
                </a>
            </div>
        </div>

        <!-- Analytics Section -->
        <div class="nav-section">
            <div class="nav-section-title">Analytics</div>

            <div class="nav-item">
                <a href="/admin/analytics" class="nav-link <%= currentPage === 'analytics' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="nav-text">Thống kê</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/admin/audit-logs" class="nav-link <%= currentPage === 'audit' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-history"></i></span>
                    <span class="nav-text">Lịch sử</span>
                </a>
            </div>
        </div>

        <!-- Settings Section -->
        <div class="nav-section">
            <div class="nav-section-title">System</div>

            <div class="nav-item">
                <a href="/admin/settings" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %>">
                    <span class="nav-icon"><i class="fas fa-cog"></i></span>
                    <span class="nav-text">Cài đặt</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/admin/logout" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="nav-text">Đăng xuất</span>
                </a>
            </div>
        </div>
    </nav>
</aside>

</aside>