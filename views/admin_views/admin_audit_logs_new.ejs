<!DOCTYPE html>
<html lang="vi">

<head>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử hoạt động - Miệt Vườn Restaurant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
        crossorigin="anonymous" />
    <link href="/css/admin-modern.css" rel="stylesheet">
    <link href="/css/snackbar.css" rel="stylesheet">
</head>

<body>
    <%- include('admin_layouts/admin_sidebar_modern', { currentPage: 'audit' }) %>
        <%- include('admin_layouts/admin_header_modern', { breadcrumb: ['Hệ thống', 'Lịch sử hoạt động' ], user:
            locals.user || {}, hasNotifications: false }) %>

            <main class="modern-content">
                <!-- Page Header -->
                <div style="margin-bottom: 2rem;">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <h1
                                style="font-size: 1.875rem; font-weight: 700; color: var(--gray-900); margin-bottom: 0.5rem;">
                                Lịch sử hoạt động
                            </h1>
                            <p style="color: var(--gray-600);">Theo dõi các thay đổi và tác động trong hệ thống</p>
                        </div>
                    </div>
                </div>

                <!-- Stats/Summary -->
                <div
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                    <div class="modern-card">
                        <div class="card-body">
                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                <div>
                                    <p style="font-size: 0.875rem; color: var(--gray-600); margin-bottom: 0.5rem;">Tổng
                                        số logs</p>
                                    <p style="font-size: 1.875rem; font-weight: 700; color: var(--gray-900);">
                                        <%= pagination.total %>
                                    </p>
                                </div>
                                <div
                                    style="width: 48px; height: 48px; background: linear-gradient(135deg, #78909c, #455a64); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-history" style="font-size: 1.5rem; color: white;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="modern-card" style="margin-bottom: 2rem;">
                    <div class="card-body">
                        <form action="/admin/audit-logs" method="GET"
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">

                            <div>
                                <label
                                    style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--gray-700);">
                                    Hành động
                                </label>
                                <select name="action"
                                    style="width: 100%; padding: 0.625rem 1rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem;">
                                    <option value="">Tất cả</option>
                                    <option value="CREATE" <%=filters.action==='CREATE' ? 'selected' : '' %>>Tạo mới
                                    </option>
                                    <option value="UPDATE" <%=filters.action==='UPDATE' ? 'selected' : '' %>>Cập nhật
                                    </option>
                                    <option value="DELETE" <%=filters.action==='DELETE' ? 'selected' : '' %>>Xóa
                                    </option>
                                    <option value="STATUS_CHANGE" <%=filters.action==='STATUS_CHANGE' ? 'selected' : ''
                                        %>>Đổi trạng thái</option>
                                    <option value="LOGIN" <%=filters.action==='LOGIN' ? 'selected' : '' %>>Đăng nhập
                                    </option>
                                    <option value="LOGOUT" <%=filters.action==='LOGOUT' ? 'selected' : '' %>>Đăng xuất
                                    </option>
                                </select>
                            </div>

                            <div>
                                <label
                                    style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--gray-700);">
                                    Đối tượng
                                </label>
                                <select name="entityType"
                                    style="width: 100%; padding: 0.625rem 1rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem;">
                                    <option value="">Tất cả</option>
                                    <option value="products" <%=filters.entityType==='products' ? 'selected' : '' %>>Sản
                                        phẩm</option>
                                    <option value="orders" <%=filters.entityType==='orders' ? 'selected' : '' %>>Đơn
                                        hàng</option>
                                    <option value="users" <%=filters.entityType==='users' ? 'selected' : '' %>>Người
                                        dùng</option>
                                    <option value="auth" <%=filters.entityType==='auth' ? 'selected' : '' %>>Hệ thống
                                    </option>
                                </select>
                            </div>

                            <div>
                                <label
                                    style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--gray-700);">
                                    Từ ngày
                                </label>
                                <input type="date" name="startDate" value="<%= filters.startDate || '' %>"
                                    style="width: 100%; padding: 0.625rem 1rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem;">
                            </div>

                            <div>
                                <label
                                    style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--gray-700);">
                                    Đến ngày
                                </label>
                                <input type="date" name="endDate" value="<%= filters.endDate || '' %>"
                                    style="width: 100%; padding: 0.625rem 1rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem;">
                            </div>

                            <div style="display: flex; gap: 0.5rem;">
                                <button type="submit" class="btn-modern btn-primary" style="height: 42px; flex: 1;">
                                    <i class="fas fa-filter"></i> Lọc
                                </button>
                                <a href="/admin/audit-logs" class="btn-modern btn-secondary"
                                    style="height: 42px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-redo"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Logs Table -->
                <div class="modern-card">
                    <div class="card-body" style="padding: 0;">
                        <div class="table-responsive">
                            <table class="modern-table" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="padding: 1rem 1.5rem; text-align: left;">Thời gian</th>
                                        <th style="padding: 1rem 1.5rem; text-align: left;">Người thực hiện</th>
                                        <th style="padding: 1rem 1.5rem; text-align: center;">Hành động</th>
                                        <th style="padding: 1rem 1.5rem; text-align: left;">Đối tượng</th>
                                        <th style="padding: 1rem 1.5rem; text-align: left;">IP</th>
                                        <th style="padding: 1rem 1.5rem; text-align: center;">Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (logs.length===0) { %>
                                        <tr>
                                            <td colspan="6" style="padding: 4rem; text-align: center;">
                                                <i class="fas fa-search"
                                                    style="font-size: 3rem; color: var(--gray-300); margin-bottom: 1rem;"></i>
                                                <p style="color: var(--gray-500);">Không có lịch sử hoạt động nào khớp
                                                    với bộ lọc</p>
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% logs.forEach(log=> { %>
                                                <tr>
                                                    <td style="padding: 1rem 1.5rem; white-space: nowrap;">
                                                        <div style="font-weight: 500; font-family: monospace;">
                                                            <%= new Date(log.created_at).toLocaleString('vi-VN') %>
                                                        </div>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem;">
                                                        <div style="font-weight: 500; color: var(--gray-900);">
                                                            <%= log.user_email || 'Hệ thống' %>
                                                        </div>
                                                        <% if (log.user_id) { %>
                                                            <div style="font-size: 0.75rem; color: var(--gray-500);">ID:
                                                                <%= log.user_id %>
                                                            </div>
                                                            <% } %>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <% let actionConfig={ 'CREATE' : { color: '#66bb6a' ,
                                                            text: 'Tạo mới' }, 'UPDATE' : { color: '#29b6f6' ,
                                                            text: 'Cập nhật' }, 'DELETE' : { color: '#ef5350' ,
                                                            text: 'Xóa' }, 'STATUS_CHANGE' : { color: '#ffa726' ,
                                                            text: 'Đổi trạng thái' }, 'LOGIN' : { color: '#ab47bc' ,
                                                            text: 'Đăng nhập' }, 'LOGOUT' : { color: '#78909c' ,
                                                            text: 'Đăng xuất' } }; let config=actionConfig[log.action]
                                                            || { color: '#9e9e9e' , text: log.action }; %>
                                                            <span class="status-badge"
                                                                style="background-color: <%= config.color %>20; color: <%= config.color %>; padding: 0.375rem 0.75rem; border-radius: 99px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                                                                <%= config.text %>
                                                            </span>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem;">
                                                        <div style="font-weight: 500; text-transform: capitalize;">
                                                            <%= log.entity_type %>
                                                        </div>
                                                        <% if (log.entity_id) { %>
                                                            <div style="font-size: 0.75rem; color: var(--gray-500);">ID:
                                                                <%= log.entity_id %>
                                                            </div>
                                                            <% } %>
                                                    </td>
                                                    <td
                                                        style="padding: 1rem 1.5rem; font-family: monospace; color: var(--gray-600);">
                                                        <%= log.ip_address || '-' %>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <button onclick="viewLogDetail(<%= log.log_id %>)"
                                                            style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--gray-200); background: white; color: var(--gray-600); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s;"
                                                            onmouseover="this.style.color='var(--primary-green)'; this.style.borderColor='var(--primary-green)';"
                                                            onmouseout="this.style.color='var(--gray-600)'; this.style.borderColor='var(--gray-200)';">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Pagination -->
                <% if (pagination.totalPages> 1) { %>
                    <div class="modern-card" style="margin-top: 1.5rem;">
                        <div class="card-body">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <p style="color: var(--gray-600); font-size: 0.875rem;">
                                    Trang <%= pagination.page %> / <%= pagination.totalPages %>
                                </p>
                                <div style="display: flex; gap: 0.5rem;">
                                    <% if (pagination.hasPrev) { %>
                                        <a href="?page=<%= pagination.page - 1 %>&action=<%= filters.action %>&entityType=<%= filters.entityType %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"
                                            class="btn-modern btn-secondary" style="padding: 0.5rem 1rem;">
                                            <i class="fas fa-chevron-left"></i> Trước
                                        </a>
                                        <% } %>

                                            <% if (pagination.hasNext) { %>
                                                <a href="?page=<%= pagination.page + 1 %>&action=<%= filters.action %>&entityType=<%= filters.entityType %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"
                                                    class="btn-modern btn-primary" style="padding: 0.5rem 1rem;">
                                                    Sau <i class="fas fa-chevron-right"></i>
                                                </a>
                                                <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                        <%- include('../admin_layouts/admin_footer_modern') %>
            </main>

            <!-- Log Detail Modal -->
            <div id="logDetailModal" class="modal"
                style="display: none; position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
                <div class="modal-content modern-card"
                    style="width: 100%; max-width: 800px; max-height: 90vh; overflow-y: auto; margin: 1rem;">
                    <div
                        style="padding: 1.5rem; border-bottom: 1px solid var(--gray-200); display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--gray-900);">Chi tiết Log</h3>
                        <button onclick="closeLogDetail()"
                            style="background: none; border: none; font-size: 1.5rem; color: var(--gray-500); cursor: pointer;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div id="logDetailContent" style="padding: 1.5rem;">
                        <!-- Content loaded dynamically -->
                        <div style="text-align: center; color: var(--gray-500);">
                            <i class="fas fa-spinner fa-spin"></i> Đang tải...
                        </div>
                    </div>
                </div>
            </div>

            <script src="/js/snackbar.js"></script>
            <script>
                async function viewLogDetail(logId) {
                    const modal = document.getElementById('logDetailModal');
                    const content = document.getElementById('logDetailContent');
                    modal.style.display = 'flex';

                    try {
                        const response = await fetch(`/admin/audit-logs/${logId}`);
                        if (!response.ok) throw new Error('Không thể tải log');

                        const log = await response.json();

                        let oldValuesHtml = '<span style="color: var(--gray-400); font-style: italic;">(Trống)</span>';
                        let newValuesHtml = '<span style="color: var(--gray-400); font-style: italic;">(Trống)</span>';

                        if (log.old_values) {
                            try {
                                const oldData = typeof log.old_values === 'string' ? JSON.parse(log.old_values) : log.old_values;
                                oldValuesHtml = `<pre style="background: var(--gray-50); padding: 1rem; border-radius: 8px; font-size: 0.875rem; overflow-x: auto; border: 1px solid var(--gray-200);">${JSON.stringify(oldData, null, 2)}</pre>`;
                            } catch (e) {
                                oldValuesHtml = `<pre style="background: var(--gray-50); padding: 1rem; border-radius: 8px; font-size: 0.875rem; overflow-x: auto; border: 1px solid var(--gray-200);">${log.old_values}</pre>`;
                            }
                        }

                        if (log.new_values) {
                            try {
                                const newData = typeof log.new_values === 'string' ? JSON.parse(log.new_values) : log.new_values;
                                newValuesHtml = `<pre style="background: var(--gray-50); padding: 1rem; border-radius: 8px; font-size: 0.875rem; overflow-x: auto; border: 1px solid var(--gray-200);">${JSON.stringify(newData, null, 2)}</pre>`;
                            } catch (e) {
                                newValuesHtml = `<pre style="background: var(--gray-50); padding: 1rem; border-radius: 8px; font-size: 0.875rem; overflow-x: auto; border: 1px solid var(--gray-200);">${log.new_values}</pre>`;
                            }
                        }

                        content.innerHTML = `
                             <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                                <div>
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Log ID</p>
                                    <p style="font-weight: 500;">#${log.log_id}</p>
                                </div>
                                <div>
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Thời gian</p>
                                    <p style="font-weight: 500;">${new Date(log.created_at).toLocaleString('vi-VN')}</p>
                                </div>
                                <div>
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Người dùng</p>
                                    <p style="font-weight: 500;">${log.user_email || 'Hệ thống'} <span style="font-weight: normal; color: var(--gray-500);">(ID: ${log.user_id || 'system'})</span></p>
                                </div>
                                <div>
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">Hành động</p>
                                    <p style="font-weight: 600; color: var(--gray-900);">${log.action} <span style="font-weight: 400; color: var(--gray-600);">on ${log.entity_type}</span></p>
                                </div>
                                <div>
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">IP Address</p>
                                    <p style="font-family: monospace;">${log.ip_address || '-'}</p>
                                </div>
                                <div style="grid-column: 1 / -1;">
                                    <p style="margin-bottom: 0.25rem; font-size: 0.75rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.05em;">User Agent</p>
                                    <p style="font-family: monospace; font-size: 0.875rem; color: var(--gray-600); word-break: break-all;">${log.user_agent || '-'}</p>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                                <div>
                                    <h4 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.75rem;">Giá trị cũ</h4>
                                    ${oldValuesHtml}
                                </div>
                                <div>
                                    <h4 style="font-weight: 600; color: var(--gray-900); margin-bottom: 0.75rem;">Giá trị mới</h4>
                                    ${newValuesHtml}
                                </div>
                            </div>
                        `;

                    } catch (error) {
                        console.error('Error loading detail:', error);
                        content.innerHTML = `<p style="color: var(--error-main); text-align: center;">Lỗi tải dữ liệu: ${error.message}</p>`;
                    }
                }

                function closeLogDetail() {
                    document.getElementById('logDetailModal').style.display = 'none';
                }

                document.getElementById('logDetailModal').addEventListener('click', function (e) {
                    if (e.target === this) closeLogDetail();
                });
            </script>
</body>

</html>