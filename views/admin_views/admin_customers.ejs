<!DOCTYPE html>
<html lang="vi">

<head>
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Khách hàng - Miệt Vườn Restaurant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
        crossorigin="anonymous" />
    <link href="/css/admin-modern.css" rel="stylesheet">
    <link href="/css/snackbar.css" rel="stylesheet">
    <script src="/js/snackbar.js"></script>
</head>

<body>
    <%- include('admin_layouts/admin_sidebar_modern', { currentPage: 'customers' , pendingOrders: 0 }) %>
        <%- include('admin_layouts/admin_header_modern', { breadcrumb: ['Quản lý', 'Khách hàng' ], user: locals.user ||
            {}, hasNotifications: false }) %>

            <main class="modern-content">
                <!-- Page Header -->
                <div style="margin-bottom: 2rem;">
                    <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--gray-900); margin-bottom: 0.5rem;">
                        Quản lý Khách hàng
                    </h1>
                    <p style="color: var(--gray-600);">Xem và quản lý thông tin khách hàng</p>
                </div>

                <!-- Search -->
                <div class="modern-card" style="margin-bottom: 2rem;">
                    <div class="card-body">
                        <form method="GET" action="/admin/customer"
                            style="display: flex; gap: 1rem; align-items: flex-end;">
                            <div style="flex: 1;">
                                <label
                                    style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--gray-700);">
                                    Tìm kiếm
                                </label>
                                <input type="text" name="search" value="<%= search %>"
                                    placeholder="Tên, email, số điện thoại..."
                                    style="width: 100%; padding: 0.625rem 1rem; border: 1px solid var(--gray-300); border-radius: 8px; font-size: 0.875rem;">
                            </div>
                            <button type="submit" class="btn-modern btn-primary">
                                <i class="fas fa-search"></i> Tìm kiếm
                            </button>
                            <a href="/admin/customer" class="btn-modern btn-secondary">
                                <i class="fas fa-redo"></i> Reset
                            </a>
                        </form>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid" style="margin-bottom: 2rem;">
                    <div class="stat-card">
                        <div class="stat-header">
                            <div class="stat-icon blue">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="stat-value">
                            <%= pagination.total %>
                        </div>
                        <div class="stat-label">Tổng khách hàng</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <div class="stat-icon green">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                        </div>
                        <div class="stat-value">
                            <%= customers.filter(c=> parseInt(c.total_orders) > 0).length %>
                        </div>
                        <div class="stat-label">Đã mua hàng</div>
                    </div>
                </div>

                <!-- Customers Table -->
                <div class="modern-card">
                    <div class="card-header">
                        <h2 class="card-title">Danh sách khách hàng (<%= pagination.total %>)</h2>
                    </div>
                    <div class="card-body" style="padding: 0;">
                        <% if (customers.length===0) { %>
                            <div style="text-align: center; padding: 4rem 2rem; color: var(--gray-500);">
                                <i class="fas fa-inbox" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                                <p>Không tìm thấy khách hàng nào</p>
                            </div>
                            <% } else { %>
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>Khách hàng</th>
                                            <th>Liên hệ</th>
                                            <th>Tổng đơn</th>
                                            <th>Tổng chi tiêu</th>
                                            <th>Ngày tham gia</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% customers.forEach(customer=> { %>
                                            <tr>
                                                <td>
                                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                        <div
                                                            style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-green) 0%, var(--primary-green-dark) 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                                                            <%= customer.name ? customer.name.charAt(0).toUpperCase()
                                                                : 'U' %>
                                                        </div>
                                                        <div>
                                                            <div style="font-weight: 500; color: var(--gray-900);">
                                                                <%= customer.name || 'N/A' %>
                                                            </div>
                                                            <div style="font-size: 0.875rem; color: var(--gray-500);">
                                                                ID: <%= customer.id %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="font-size: 0.875rem;">
                                                        <div style="color: var(--gray-900); margin-bottom: 0.25rem;">
                                                            <i class="fas fa-envelope"
                                                                style="color: var(--gray-400); margin-right: 0.5rem;"></i>
                                                            <%= customer.email || 'N/A' %>
                                                        </div>
                                                        <div style="color: var(--gray-600);">
                                                            <i class="fas fa-phone"
                                                                style="color: var(--gray-400); margin-right: 0.5rem;"></i>
                                                            <%= customer.phone || 'N/A' %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span
                                                        style="padding: 0.375rem 0.75rem; border-radius: 12px; font-size: 0.875rem; font-weight: 600; <%= parseInt(customer.total_orders) > 0 ? 'background: rgba(76, 175, 80, 0.1); color: var(--success);' : 'background: var(--gray-100); color: var(--gray-700);' %>">
                                                        <%= customer.total_orders || 0 %> đơn
                                                    </span>
                                                </td>
                                                <td style="font-weight: 600; color: var(--gray-900);">
                                                    <%= parseFloat(customer.total_spent || 0).toLocaleString('vi-VN') %>
                                                        VNĐ
                                                </td>
                                                <td style="color: var(--gray-600); font-size: 0.875rem;">
                                                    <%= new Date(customer.created_at).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td>
                                                    <button onclick="viewCustomerOrders(<%= customer.id %>)"
                                                        class="btn-modern btn-outline"
                                                        style="font-size: 0.875rem; padding: 0.5rem 1rem;">
                                                        <i class="fas fa-history"></i> Lịch sử
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                                <% } %>
                    </div>
                </div>
            </main>

            <!-- Customer Orders Modal -->
            <div id="customerOrdersModal"
                class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
                <div class="bg-white rounded-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold">Lịch sử đơn hàng</h3>
                            <button onclick="closeCustomerOrders()" class="text-gray-500 hover:text-gray-700">
                                <i class="fas fa-times text-2xl"></i>
                            </button>
                        </div>
                        <div id="customerOrdersContent">
                            <!-- Orders will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
            <% if (locals.success && success.length > 0) { %>
                        Snackbar.success('<%= success[0] %>');
            <% } %>
            <% if (locals.error && error.length > 0) { %>
                        Snackbar.error('<%= error[0] %>');
            <% } %>
        });

                async function viewCustomerOrders(customerId) {
                    try {
                        const response = await fetch(`/admin/customer/${customerId}/orders`);
                        const data = await response.json();

                        const ordersHtml = data.orders.length === 0
                            ? '<p class="text-gray-500 text-center py-8">Chưa có đơn hàng nào</p>'
                            : data.orders.map(order => `
                        <div class="border-b py-4 hover:bg-gray-50">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="font-medium">#${order.order_code}</p>
                                    <p class="text-sm text-gray-500">${new Date(order.created_at).toLocaleString('vi-VN')}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-green-600">${parseInt(order.total).toLocaleString('vi-VN')} VNĐ</p>
                                    <span class="px-2 py-1 text-xs rounded-full ${order.status === 'Completed' ? 'bg-green-100 text-green-800' :
                                    order.status === 'Pending' ? 'bg-yellow-100 text-yellow-800' :
                                        order.status === 'Canceled' ? 'bg-red-100 text-red-800' :
                                            'bg-blue-100 text-blue-800'
                                }">${order.status}</span>
                                </div>
                            </div>
                        </div>
                    `).join('');

                        document.getElementById('customerOrdersContent').innerHTML = ordersHtml;
                        document.getElementById('customerOrdersModal').classList.remove('hidden');
                    } catch (error) {
                        console.error('Error:', error);
                        Snackbar.error('Không thể tải lịch sử đơn hàng');
                    }
                }

                function closeCustomerOrders() {
                    document.getElementById('customerOrdersModal').classList.add('hidden');
                }
            </script>
</body>

</html>