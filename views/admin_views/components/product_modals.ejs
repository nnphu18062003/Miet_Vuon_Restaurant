<!-- Add/Edit Product Modal -->
<div id="productModal"
    style="display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div
        style="background: white; width: 600px; max-width: 90%; max-height: 90vh; overflow-y: auto; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <div style="text-align: center; padding: 1.5rem 1.5rem 1rem;">
            <h2 id="modalTitle" style="font-size: 1.5rem; font-weight: 700; color: var(--gray-900);">Thêm món mới</h2>
        </div>

        <div style="padding: 0 1.5rem 1.5rem;">
            <form id="productForm" enctype="multipart/form-data">
                <input type="hidden" id="productId" name="productId">

                <!-- Product Image -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Hình
                        ảnh</label>
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <img id="productImagePreview" src="/admin/images/default-food.png" alt="Preview"
                            style="width: 128px; height: 128px; object-fit: cover; border-radius: 8px; border: 1px solid var(--gray-300);">
                        <input type="file" id="productImage" name="image" accept="image/*"
                            style="flex: 1; padding: 0.5rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                    </div>
                </div>

                <!-- Product Name -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Tên
                        món *</label>
                    <input type="text" id="productName" name="name" required
                        style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                </div>

                <!-- Description -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Mô
                        tả</label>
                    <textarea id="productDescription" name="description" rows="3"
                        style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;"></textarea>
                </div>

                <!-- Price -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Giá
                        (VNĐ) *</label>
                    <input type="number" id="productPrice" name="price" required min="0"
                        style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                </div>

                <!-- Category -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Danh
                        mục *</label>
                    <select id="productCategory" name="category_id" required
                        style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                        <option value="">Chọn danh mục</option>
                    </select>
                </div>

                <!-- Discount -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div>
                        <label
                            style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Giảm
                            giá (%)</label>
                        <input type="number" id="productDiscount" name="discount" min="0" max="100" value="0"
                            style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                    </div>
                    <div style="display: flex; align-items: flex-end;">
                        <label style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="checkbox" id="discountActive" name="is_discount_active"
                                style="width: 16px; height: 16px;">
                            <span style="font-size: 0.875rem; color: var(--gray-700);">Kích hoạt giảm giá</span>
                        </label>
                    </div>
                </div>

                <!-- Status & Best Seller -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" id="productStatus" name="status" checked
                            style="width: 16px; height: 16px;">
                        <span style="font-size: 0.875rem; color: var(--gray-700);">Còn món</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" id="bestSeller" name="is_best_seller" style="width: 16px; height: 16px;">
                        <span style="font-size: 0.875rem; color: var(--gray-700);">Best Seller</span>
                    </label>
                </div>

                <!-- Custom Label -->
                <div style="margin-bottom: 1rem;">
                    <label
                        style="display: block; font-size: 0.875rem; font-weight: 500; color: var(--gray-700); margin-bottom: 0.5rem;">Nhãn
                        tùy chỉnh</label>
                    <input type="text" id="customLabel" name="custom_label" placeholder="VD: Mới, Hot, Sale..."
                        style="width: 100%; padding: 0.625rem; border: 1px solid var(--gray-300); border-radius: 8px;">
                </div>

                <!-- Buttons -->
                <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                    <button type="submit" class="btn-modern btn-primary" style="flex: 1;">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <button type="button" onclick="closeProductModal()" class="btn-modern btn-secondary"
                        style="flex: 1;">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal"
    style="display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 1000;">
    <div
        style="background: white; width: 500px; max-width: 90%; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <div style="text-align: center; padding: 1.5rem 1.5rem 1rem;">
            <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--gray-900);">Xác nhận xóa món</h2>
        </div>
        <div style="text-align: center; padding: 0 1.5rem 1.5rem;">
            <p style="color: var(--gray-600); margin-bottom: 1.5rem;">Bạn có chắc chắn muốn xóa món này không?</p>
            <div style="display: flex; gap: 0.75rem; justify-content: center;">
                <button onclick="confirmDelete()" class="btn-modern"
                    style="background: var(--error); border-color: var(--error);">
                    <i class="fas fa-trash"></i> Xóa
                </button>
                <button onclick="closeDeleteModal()" class="btn-modern btn-secondary">
                    <i class="fas fa-times"></i> Hủy
                </button>
            </div>
        </div>
    </div>
</div>