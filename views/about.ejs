<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="referrer" content="always" />
    <meta name="description" content="Giới thiệu về nhà hàng Miet Vuon Restaurant" />
    <link href="//fonts.googleapis.com/css?family=Righteous" rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Open+Sans+Condensed:300,300i,700" rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i" rel="stylesheet" />
    <link rel="stylesheet" href="/css/all.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link id="favicon" rel="icon" type="image/png" href="/images/favicon.png">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../dist/main.css" />
    <style>
        .section-title {
            color: #66BB6A;
            font-size: 2rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .section-subtitle {
            font-size: 1.125rem;
            color: #555;
            text-align: center;
            margin-bottom: 2rem;
        }

        .about-text {
            font-size: 1.125rem;
            color: #555;
            text-align: justify;
            margin-bottom: 2rem;
        }

        .founder-description {
            font-size: 1.125rem;
            color: #555;
            text-align: justify;
            margin: 0 auto 2rem auto;
            max-width: 800px;
            padding: 0 1rem;
        }


        .card {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.1);
        }

        .team-card {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 1rem;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }

        .team-card img {
        border-radius: 50%;       
        width: 80px;
        height: 80px;
        object-fit: cover;
        }

       
        .content-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
    </style>
</head>

<body class="bg-gray-100 font-sans leading-normal tracking-normal">
    <!-- Header -->
    <%- include('layouts/mainLayout', { content: locals.body }) %>

    <!-- About Section -->
    <!-- Hình của trang chủ -->
    <div class="relative flex items-center justify-center overflow-hidden w-full" style="height: 700px;">
        <div id="imageSlider" class="flex transition-transform duration-500 ease-in-out" style="width: 100%; height: 100%;">
            <img src="/images/homepage1.png" alt="Homepage 1" class="flex-shrink-0 w-full h-full object-cover">
            <img src="/images/homepage2.png" alt="Homepage 2" class="flex-shrink-0 w-full h-full object-cover">
            <img src="/images/homepage3.png" alt="Homepage 3" class="flex-shrink-0 w-full h-full object-cover">
            <img src="/images/homepage4.png" alt="Homepage 4" class="flex-shrink-0 w-full h-full object-cover">
            <img src="/images/homepage5.png" alt="Homepage 5" class="flex-shrink-0 w-full h-full object-cover">
        </div>
        <!-- Nút chuyển ảnh -->
        <button id="prev" class="absolute top-1/2 left-4 transform -translate-y-1/2 bg-gray-600/80 hover:bg-gray-700 text-white px-4 py-2 rounded-full text-2xl font-bold transition-colors z-10">‹</button>
        <button id="next" class="absolute top-1/2 right-4 transform -translate-y-1/2 bg-gray-600/80 hover:bg-gray-700 text-white px-4 py-2 rounded-full text-2xl font-bold transition-colors z-10">›</button>
    </div>

    <main class="container mx-auto px-4 py-8">

        <section class="content-center">
            <h2 class="section-title">Về Chúng Tôi</h2>
            <p class="about-text">
                Miet Vuon Restaurant là một nhà hàng trẻ trung và năng động, chuyên cung cấp các món ăn nhanh ngon miệng, đảm bảo chất lượng và phong cách phục vụ tuyệt vời. Thành lập bởi một nhóm 5 người sáng lập đam mê ẩm thực, Miet Vuon Restaurant không chỉ là nơi mang đến những món ăn đa dạng mà còn là không gian lý tưởng để tận hưởng những phút giây thư giãn và sum vầy cùng gia đình, bạn bè. Mỗi món ăn tại Miet Vuon Restaurant đều được chế biến với nguyên liệu tươi ngon, đảm bảo an toàn vệ sinh thực phẩm, và phục vụ nhanh chóng, thuận tiện.
            </p>
            <p class="about-text">
                Với sứ mệnh mang đến cho khách hàng những trải nghiệm ẩm thực độc đáo và tiện lợi, Miet Vuon Restaurant luôn không ngừng đổi mới để tạo ra những món ăn sáng tạo và phù hợp với khẩu vị của nhiều đối tượng khách hàng. Nhà hàng của chúng tôi không chỉ đơn thuần là nơi ăn uống, mà còn là điểm đến cho những ai yêu thích không gian hiện đại, trẻ trung và đầy năng lượng. Chúng tôi mong muốn Miet Vuon Restaurant sẽ là lựa chọn hàng đầu của bạn khi cần tìm một nơi để thưởng thức những món ăn ngon, phục vụ tận tình và tận hưởng không khí ấm cúng.
            </p>
            <p class="about-text">
                Bên cạnh đó, Miet Vuon Restaurant cũng đặc biệt chú trọng đến việc tạo dựng mối quan hệ gắn bó với khách hàng. Chúng tôi luôn lắng nghe và cải thiện dịch vụ để mang đến những trải nghiệm hoàn hảo nhất. Với tầm nhìn dài hạn, Miet Vuon Restaurant không ngừng nỗ lực để trở thành thương hiệu ẩm thực nổi bật, góp phần nâng cao giá trị ẩm thực Việt Nam trên bản đồ thế giới.
            </p>
        </section>

        <!-- Core Values Section -->
        <section>
            <h2 class="section-title">Giá Trị Cốt Lõi</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="card">
                    <h3 class="text-xl font-bold mb-2">Sáng Tạo</h3>
                    <p>Luôn đổi mới và sáng tạo trong từng món ăn để mang đến trải nghiệm ẩm thực độc đáo.</p>
                </div>
                <div class="card">
                    <h3 class="text-xl font-bold mb-2">Khách Hàng Là Trung Tâm</h3>
                    <p>Đặt khách hàng lên hàng đầu, mang lại sự hài lòng và trải nghiệm tuyệt vời nhất.</p>
                </div>
                <div class="card">
                    <h3 class="text-xl font-bold mb-2">Đồng Cảm</h3>
                    <p>Tôn trọng và đồng cảm với khách hàng, nhân viên và đối tác, tạo ra một môi trường làm việc tích cực.</p>
                </div>
            </div>
        </section>

        <!-- Restaurant Space Section -->
        <section>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <img src="/images/View_1.png" alt="Không gian 1" class="w-full h-64 object-cover rounded-lg shadow-lg">
                <img src="/images/View_2.png" alt="Không gian 2" class="w-full h-64 object-cover rounded-lg shadow-lg">
                <img src="/images/View_3.png" alt="Không gian 3" class="w-full h-64 object-cover rounded-lg shadow-lg">
            </div>
        </section>

        <!-- Team Section -->
        <section class="mt-12 text-center">
            <h2 class="section-title">Nhà Sáng Lập</h2>
            <p class="founder-description">Nhà sáng lập của "Miet Vuon Restaurant" là người đam mê ẩm thực, mong muốn của anh là mang những món ăn dân dã, đậm đà mùi vị Việt Nam đến với mọi người, xây dựng một thương hiệu ẩm thực Việt Nam trẻ trung, năng động và giữ nguyên vẹn phong cách dân dã miền Tây, Việt Nam.</p>
            <div class="flex justify-center">
                <!-- Founder 1 -->
                <div class="team-card">
                    <img src="/images/NGOCPHU.png" alt="Nguyễn Ngọc Phú">
                    <div>
                        <h3 class="text-xl font-bold">Nguyễn Ngọc Phú</h3>
                        <p>Nhà sáng lập & Giám đốc điều hành</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('layouts/footer') %>

    <script src="/js/cart.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/js/filterHandlingAndPaginationAJAX.js"></script>

    <!-- Di chuyển ảnh -->
    <script>
        const slider = document.getElementById("imageSlider");
        const prevBtn = document.getElementById("prev");
        const nextBtn = document.getElementById("next");
    
        let currentIndex = 0; // Vị trí ảnh hiện tại
        let autoSlideInterval; // Biến lưu interval tự động chuyển slide
    
        function updateSlider() {
            const offset = currentIndex * -100; // Dịch chuyển -100% mỗi slide
            slider.style.transform = `translateX(${offset}%)`;
        }
    
        function nextSlide() {
            if (currentIndex < slider.children.length - 1) {
                currentIndex++;
            } else {
                currentIndex = 0; // Quay lại ảnh đầu tiên
            }
            updateSlider();
        }
    
        function prevSlide() {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = slider.children.length - 1; // Chuyển đến ảnh cuối cùng
            }
            updateSlider();
        }
    
        nextBtn.addEventListener("click", () => {
            nextSlide();
            resetAutoSlide(); // Reset timer khi người dùng click
        });
    
        prevBtn.addEventListener("click", () => {
            prevSlide();
            resetAutoSlide(); // Reset timer khi người dùng click
        });
    
        // Tự động chuyển slide sau mỗi 5 giây
        function startAutoSlide() {
            autoSlideInterval = setInterval(() => {
                nextSlide();
            }, 5000);
        }
    
        // Reset auto slide timer
        function resetAutoSlide() {
            clearInterval(autoSlideInterval);
            startAutoSlide();
        }
    
        // Bắt đầu auto slide khi trang load
        startAutoSlide();
    
        // Dừng auto slide khi hover vào slider
        slider.addEventListener("mouseenter", () => {
            clearInterval(autoSlideInterval);
        });
    
        // Tiếp tục auto slide khi rời chuột
        slider.addEventListener("mouseleave", () => {
            startAutoSlide();
        });
    </script>
</body>

</html>
