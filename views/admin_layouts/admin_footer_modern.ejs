<!-- Admin Footer -->
<footer
    style="margin-top: 3rem; padding: 1.5rem 0; border-top: 1px solid var(--gray-200); color: var(--gray-500); font-size: 0.875rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            &copy; <%= new Date().getFullYear() %> <strong>Miệt Vườn Restaurant</strong>. All rights reserved.
        </div>
        <div style="display: flex; gap: 1.5rem;">
            <a href="#" style="color: var(--gray-500); text-decoration: none; transition: color 0.2s;"
                onmouseover="this.style.color='var(--primary-green)'" onmouseout="this.style.color='var(--gray-500)'">Hỗ
                trợ</a>
            <a href="#" style="color: var(--gray-500); text-decoration: none; transition: color 0.2s;"
                onmouseover="this.style.color='var(--primary-green)'"
                onmouseout="this.style.color='var(--gray-500)'">Tài liệu</a>
            <span style="color: var(--gray-300);">|</span>
            <span>Version 1.0.0</span>
        </div>
    </div>
</footer>